# Copy to .env.dev and fill in real values. Never commit .env.dev — it is gitignored.
# Rotate SECRET_KEY and SMTP_PASSWORD if they were ever exposed.

DATABASE_URL=sqlite+aiosqlite:///platform.db

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-hex-chars

SMTP_HOST=your-smtp-host.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=replace-with-real-password
SMTP_FROM=noreply@yourdomain.com
